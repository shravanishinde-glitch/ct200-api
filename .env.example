# --- LLM (Groq free tier: https://console.groq.com) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Generated-output store ---
# Leave MONGO_URI empty to use the JSON-file store (GEN_STORE_PATH). Set it for MongoDB / Atlas.
MONGO_URI=
GEN_STORE_PATH=./generations.json

# --- Relational store ---
SQLITE_URL=sqlite:///./ct200.db
